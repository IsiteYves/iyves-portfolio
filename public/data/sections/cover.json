        {
            "id": 2,
            "component": "ArticleText",
            "locales": {
                "en": {
                    "title": "{{A little bit}} about me..."
                },
                "fr": {
                    "title": "{{Un peu}} à propos de moi..."
                }
            },
            "settings": {
